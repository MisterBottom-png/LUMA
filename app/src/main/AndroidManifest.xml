<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exact reminder alarms. Android may deny this; LUMA then falls back to
         inexact alarms and says so in Settings > Notifications. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+: granted at install and cannot be revoked, so a reminder saved on a
         fresh install rings at its exact minute. Private build only: it must come out
         before any Play release unless the app qualifies as an alarm or calendar app.
         Keep SCHEDULE_EXACT_ALARM above unchanged: it covers Android 12 and 12L, and it
         is the line that stays if USE_EXACT_ALARM ever has to come out. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Lets the reminder health row open the battery screen for this app. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- On-device dictation only (Android 12+): the phone's own recogniser listens and
         Tallele keeps the words, never the audio. Asked for on the first mic tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets LUMA see whether the phone has a speech recognition screen to open. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Lets the reminder health row check for Samsung's "Never sleeping apps" screen. -->
        <package android:name="com.samsung.android.lool" />
    </queries>

    <application
        android:name=".OrbitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/full_backup_rules"
        android:icon="@mipmap/ic_luma_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_luma_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Orbit.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share text into LUMA: it fills the Home draft; the user sends it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Exported only to the system UI: BIND_QUICK_SETTINGS_TILE is signature-level. -->
        <service
            android:name=".capture.NewThoughtTileService"
            android:exported="true"
            android:icon="@drawable/ic_luma_notification"
            android:label="@string/tile_new_thought"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Not exported: only the system delivers these broadcasts. -->
        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <!-- One-off reminders are instants and do not move; repeating ones are
                     re-anchored to their chosen local time. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
