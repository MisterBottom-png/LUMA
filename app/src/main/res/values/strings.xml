    <string name="settings_first_time_guide_title">First-time guide</string>
    <string name="tutorial_idea_step">01 · The idea</string>
    <string name="tutorial_idea_title">A home for thoughts before they become plans.</string>
    <string name="tutorial_idea_body">Tallele is a calm life inbox. Put a thought in first, then decide whether it belongs as a note, task, reminder, or simply in the Inbox.</string>
    <string name="tutorial_idea_principle_title">Capture first. Organise second.</string>
    <string name="tutorial_idea_principle_body">You do not need to choose a category, date, or Space before writing.</string>
    <string name="tutorial_home_step">02 · Home</string>
    <string name="tutorial_home_title">Capture thoughts and orient yourself in time.</string>
    <string name="tutorial_home_body">On Home, type a sentence, a fragment, or several thoughts, then tap the upward arrow to save and analyse it. The week strip is also your Calendar entry point: tap a day to open that date, switch between Day and Month views, or add an item directly for the selected date.</string>
    <string name="tutorial_home_principle_title">Home is the starting point.</string>
    <string name="tutorial_home_principle_body">Capture first, or use the week strip when you already know the day you need.</string>
    <string name="tutorial_confirm_step">03 · Confirm</string>
    <string name="tutorial_confirm_title">Suggestions are proposals, not commands.</string>
    <string name="tutorial_confirm_body">Tallele may suggest a note, task, reminder, Space, or time. Accept the main action, open “Change action,” edit the details, or keep the thought in Inbox until it is clearer.</string>
    <string name="tutorial_confirm_principle_title">You make the final decision.</string>
    <string name="tutorial_confirm_principle_body">Important actions are never silently created, scheduled, completed, archived, or deleted.</string>
    <string name="tutorial_brain_dump_step">04 · Brain Dump</string>
    <string name="tutorial_brain_dump_title">Several thoughts become several calm decisions.</string>
    <string name="tutorial_brain_dump_body">When one capture contains multiple ideas, Brain Dump shows one suggestion at a time. Save useful items, discard individual suggestions, or save progress and continue later.</string>
    <string name="tutorial_brain_dump_principle_title">The original stays private.</string>
    <string name="tutorial_brain_dump_principle_body">Tallele presents clean final items in Spaces instead of duplicating the raw Brain Dump.</string>
    <string name="tutorial_spaces_step">05 · Spaces</string>
    <string name="tutorial_spaces_title">Keep each part of life in its own context.</string>
    <string name="tutorial_spaces_body">Use Spaces to browse settled notes, tasks, and reminders by area of life. Search across your Spaces, open one to see its items, or use the add button to create a new Space when an area deserves its own home.</string>
    <string name="tutorial_spaces_principle_title">Spaces organise context, not time.</string>
    <string name="tutorial_spaces_principle_body">Unscheduled thoughts can remain in a Space or Inbox without being forced onto the Calendar.</string>
    <string name="tutorial_space_setup_title">Choose a few Spaces</string>
    <string name="tutorial_space_setup_body">Only pick the parts of life you want to return to. You can add, rename, or hide Spaces later.</string>
    <string name="tutorial_space_setup_name">Name a Space</string>
    <string name="tutorial_space_setup_add">Add Space</string>
    <string name="tutorial_space_setup_remove">Remove %1$s</string>
    <string name="tutorial_space_setup_error">Couldn’t save your Spaces. Try again.</string>
    <string name="tutorial_review_step">06 · Review and ask</string>
    <string name="tutorial_review_title">Return when the day gives you a reason.</string>
    <string name="tutorial_review_body">Review changes with the time of day: a morning scan, a quiet midday pause, an evening close, and a swipeable weekly view on weekends. The centre sparkle opens Situation AI and Ask Tallele using your local items as sources.</string>
    <string name="tutorial_review_principle_title">Review is not a score.</string>
    <string name="tutorial_review_principle_body">It helps resolve open loops without guilt, streaks, or productivity theatre.</string>
    <string name="tutorial_control_step">07 · Control</string>
    <string name="tutorial_control_title">Private by default. Cloud AI only by choice.</string>
    <string name="tutorial_control_body">Core Tallele features work locally. Gemini is optional, requires consent, and receives only the selected text and relevant context. Reminder permission appears when it is actually needed.</string>
    <string name="tutorial_control_principle_title">Start with one real thought.</string>
    <string name="tutorial_control_principle_body">Natural language is the intended interface. Write first; let structure arrive afterward.</string>
